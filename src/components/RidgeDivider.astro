---
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<svg
	class:list={['ridge-divider', className]}
	viewBox="0 0 400 32"
	preserveAspectRatio="none"
	aria-hidden="true"
	focusable="false"
>
	<path d="M0 28 L60 28 L95 8 L130 22 L165 4 L200 24 L240 12 L280 28 L400 28" />
	<circle cx="165" cy="4" r="3" />
</svg>
<style>
	.ridge-divider {
		display: block;
		width: 100%;
		height: 32px;
	}
	.ridge-divider path {
		fill: none;
		stroke: var(--accent);
		stroke-width: 2;
		opacity: 0.4;
		vector-effect: non-scaling-stroke;
	}
	.ridge-divider circle {
		fill: var(--rust);
	}
</style>
