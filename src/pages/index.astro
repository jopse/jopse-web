---
// Colocar en: src/pages/index.astro (sustituye el del starter)
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContourDivider from '../components/ContourDivider.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section class="intro">
        <p class="eyebrow">
          <svg class="waypoint" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="9" />
            <circle cx="12" cy="12" r="3" class="waypoint-center" />
          </svg>
          Arquitectura · Gobierno del dato · Equipos
        </p>
        <h1>
          Dirijo la arquitectura y el desarrollo de una plataforma de <em>Data Governance</em> que usan decenas de organizaciones.
        </h1>
        <p class="lede">
          Al frente de un equipo de trece personas entre desarrollo, arquitectura y QA.
          Mi trabajo es decidir dónde invertir la capacidad técnica para que el producto
          avance: qué se construye, cómo escala y qué riesgo asumimos.
        </p>
        <p class="lede">
          Vengo de la ingeniería de datos. Entiendo el problema del dato desde el
          pipeline hasta el gobierno, que es exactamente donde vive el producto que
          construyo.
        </p>
        <p class="links">
          <a href="/sobre-mi">Sobre mí</a>
          <a href="https://www.linkedin.com/in/joseangelgonzalezmejias/">LinkedIn</a>
          <a href="https://github.com/jopse">GitHub</a>
          <a href="https://x.com/jopse5">X</a>
        </p>

        <dl class="stats">
          <div class="stat">
            <dt>8 años</dt>
            <dd>liderando</dd>
          </div>
          <div class="stat">
            <dt>7 personas</dt>
            <dd>incorporadas</dd>
          </div>
          <div class="stat">
            <dt>2 releases</dt>
            <dd>al año</dd>
          </div>
          <div class="stat">
            <dt>99,9%</dt>
            <dd>disponibilidad</dd>
          </div>
        </dl>
      </section>

      <ContourDivider class="section-ridge" />

      <section class="writing">
        <h2>Escribo sobre</h2>
        <ul class="posts">
          {
            posts.map((post) => (
              <li>
                <a href={`/blog/${post.id}/`}>
                  <span class="post-title">{post.data.title}</span>
                  <span class="post-desc">{post.data.description}</span>
                </a>
              </li>
            ))
          }
        </ul>
        {posts.length > 0 && <p class="all"><a href="/blog">Todas las entradas</a></p>}
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    width: calc(100% - 2.5rem);
    max-width: 46rem;
    margin: 0 auto;
    padding: 3rem 1.25rem 5rem;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    font-family: var(--font-archivo), ui-monospace, monospace;
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-dark);
    margin: 0 0 1.25rem;
  }

  .waypoint {
    width: 18px;
    height: 18px;
    margin-right: 0.6em;
    flex-shrink: 0;
  }

  .waypoint circle {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
  }

  .waypoint .waypoint-center {
    fill: var(--rust);
    stroke: none;
  }

  h1 {
    font-size: clamp(1.7rem, 4.2vw, 2.6rem);
    line-height: 1.2;
    margin: 0 0 1.75rem;
    text-wrap: balance;
  }

  h1 em {
    font-style: italic;
    color: var(--accent);
  }

  .lede {
    font-size: 1.05rem;
    line-height: 1.65;
    margin: 0 0 1.1rem;
    color: rgb(var(--gray-dark));
  }

  .links {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-size: 0.95rem;
  }

  .stats {
    margin: 2.5rem 0 0;
    padding-top: 2rem;
    border-top: 1px solid rgb(var(--gray-light));
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 1.5rem;
  }

  .stat dt {
    font-size: 1.4rem;
    font-weight: 650;
    color: var(--accent);
  }

  .stat dd {
    margin: 0.2rem 0 0;
    font-family: var(--font-archivo), ui-monospace, monospace;
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--gray));
  }

  .section-ridge {
    margin-top: 4.5rem;
  }

  .writing {
    padding-top: 2.5rem;
  }

  .writing h2 {
    font-family: var(--font-archivo), ui-monospace, monospace;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--gray));
    font-weight: 600;
    margin: 0 0 1.5rem;
  }

  .posts {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .posts li + li {
    margin-top: 1.5rem;
  }

  .posts a {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .post-title {
    display: block;
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.35;
    margin-bottom: 0.3rem;
  }

  .posts a:hover .post-title {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-desc {
    display: block;
    color: rgb(var(--gray));
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .all {
    margin-top: 2.25rem;
    font-size: 0.95rem;
  }
</style>
